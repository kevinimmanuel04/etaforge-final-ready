{
  "name": "eta-forge-live",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "train-backend": "cd \"train backend\" && python -u train_firebase.py",
    "transport-backend": "cd \"transport ahh\" && node src/index.js",
    "airport-backend": "cd airport && python -u tracker.py",
    "frontend": "vite",
    "start": "concurrently --kill-others-on-fail \"npm run train-backend\" \"npm run transport-backend\" \"npm run airport-backend\" \"npm run frontend\" --names \"TRAIN,TRANSPORT,AIRPORT,FRONTEND\" --prefix-colors \"cyan,yellow,magenta,green\""
  },
  "dependencies": {
    "firebase": "^10.7.1",
    "framer-motion": "^10.16.4",
    "lucide-react": "^0.303.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.2.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.8"
  }
}
